    <flow name="get:\libraries:ibs-library-management-sapi-config">
        <ee:transform doc:name="Transform Message">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  libraryCode: "IB213",
  libraryBranch: "Hyderabad"
} as Object {encoding: "UTF-8", mediaType: "application/json"}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
    </flow>
    <flow name="get:\libraries\(libraryID):ibs-library-management-sapi-config">
        <ee:transform doc:name="Transform Message">
            <ee:variables>
                <ee:set-variable variableName="libraryID">attributes.uriParams.'libraryID'</ee:set-variable>
            </ee:variables>
        </ee:transform>
        <logger level="INFO" message="get:\libraries\(libraryID):ibs-library-management-sapi-config" />
		<ee:transform doc:name="Transform Message" doc:id="7676d752-ac76-47e9-a753-9d24342f7ebc" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/java
---
{
	 "Result": "this is used to get books information based on library id"
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
    </flow>
    <flow name="post:\books:application\json:ibs-library-management-sapi-config">
        <logger level="INFO" message="post:\books:application\json:ibs-library-management-sapi-config" />
		<ee:transform doc:name="Transform Message" doc:id="a915d9ff-3abc-48fb-b979-00c66073d27f" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
	"Result": "This is used to create new book"
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
    </flow>
</mule>
